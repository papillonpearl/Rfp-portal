# Postgres. Neon's pooled connection string in production; any local Postgres
# in development (postgres://rfp:rfp@localhost:5432/rfp_dev).
DATABASE_URL=

# Auth.js session signing. Generate with: npx auth secret
AUTH_SECRET=

# Resend, for sign-in links (and supplier invites from Phase 3).
# EMAIL_FROM must be on a domain verified in Resend FOR THIS PROJECT —
# not papillonpearl.com. Unset in development: emails print to the console.
# Unset in production: sign-in refuses rather than silently sending nothing.
RESEND_API_KEY=
EMAIL_FROM=

# Only for `npm run db:seed`: this address is made an admin.
SEED_ADMIN_EMAIL=
